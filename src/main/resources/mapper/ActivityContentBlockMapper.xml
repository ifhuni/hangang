<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hangang.web.activity.ActivityContentBlockMapper">

    <resultMap id="blockResultMap" type="com.hangang.web.activity.ActivityContentBlock">
        <id property="blockId" column="block_id"/>
        <result property="activityId" column="activity_id"/>
        <result property="position" column="position"/>
        <result property="blockType" column="block_type"/>
        <result property="textContent" column="text_content"/>
        <result property="imagePath" column="image_path"/>
    </resultMap>

    <select id="findByActivityId" parameterType="long" resultMap="blockResultMap">
        SELECT block_id, activity_id, position, block_type, text_content, image_path
        FROM activity_content_block
        WHERE activity_id = #{activityId}
        ORDER BY position ASC
    </select>

    <insert id="insertBlock" parameterType="com.hangang.web.activity.ActivityContentBlock"
            useGeneratedKeys="true" keyProperty="blockId">
        INSERT INTO activity_content_block (activity_id, position, block_type, text_content, image_path)
        VALUES (#{activityId}, #{position}, #{blockType}, #{textContent}, #{imagePath})
    </insert>

    <delete id="deleteByActivityId" parameterType="long">
        DELETE FROM activity_content_block WHERE activity_id = #{activityId}
    </delete>

</mapper>
